{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "..",
    "skipLibCheck": true,
    "types": []
  },
  "include": ["contracts/**/*.ts", "../contracts/deviceCheckin.ts"]
}
